BRIDGE_PORT=4000
NERVFS_HOST=127.0.0.1
NERVFS_PORT=9000

# Authentication (Generate a strong password & min 32-char secret)
ADMIN_PASSWORD=change_me_in_production
AUTH_SECRET=your_32_byte_secret_here

# CORS Origins (Use http://localhost:5173 for local dev, or your production URL)
ALLOWED_ORIGIN=http://localhost:5173

# Ngrok Configuration (Optional for local tunneling)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your_ngrok_domain_here